{
    "name": "orbinum-circuits",
    "version": "0.14.0",
    "description": "Zero-Knowledge circuits for Orbinum privacy blockchain",
    "scripts": {
        "compile": "ts-node scripts/build/compile.ts",
        "setup": "ts-node scripts/build/setup.ts",
        "convert": "ts-node scripts/build/pack-proving-key.ts",
        "build:circuit": "ts-node scripts/build/full-pipeline.ts",
        "build-all": "ts-node scripts/build-all.ts",
        "fixture": "ts-node scripts/utils/make-fixture.ts",
        "manifest": "ts-node scripts/utils/generate-manifest.ts",
        "lint": "eslint .",
        "lint:circom": "ts-node scripts/utils/lint-circom.ts",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write \"**/*.{ts,js,mjs,json,md,yml,yaml}\"",
        "format:check": "prettier --check \"**/*.{ts,js,mjs,json,md,yml,yaml}\"",
        "test": "mocha",
        "test:strict": "CIRCUITS_REQUIRE_ARTIFACTS=1 mocha",
        "check": "pnpm run lint && pnpm run typecheck && pnpm run format:check && pnpm run lint:circom && pnpm test",
        "release": "ts-node scripts/release/release.ts",
        "release:dry": "ts-node scripts/release/release.ts --dry-run",
        "release:verify": "ts-node scripts/release/verify-artifacts.ts",
        "release:restore": "ts-node scripts/release/restore-artifacts.ts",
        "clean": "rm -rf build/ dist/ pkg/ release/",
        "clean:all": "rm -rf build/ dist/ pkg/ release/ ptau/ keys/"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/chai": "^5.2.3",
        "@types/circomlibjs": "^0.1.6",
        "@types/mocha": "^10.0.10",
        "@types/node": "^25.6.0",
        "@types/snarkjs": "^0.7.9",
        "chai": "^6.2.2",
        "circom_tester": "^0.0.24",
        "circomlib": "^2.0.5",
        "eslint": "^10.9.1",
        "ffjavascript": "^0.3.1",
        "mocha": "^11.7.5",
        "prettier": "^3.8.3",
        "snarkjs": "^0.7.6",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.68.0"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "author": "Orbinum",
    "license": "GPL-3.0-or-later",
    "dependencies": {
        "@noble/hashes": "^2.2.0",
        "circomlibjs": "^0.1.7"
    },
    "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
    "pnpm": {
        "overrides": {
            "js-yaml": "^4.3.1",
            "serialize-javascript": "^7.0.5",
            "brace-expansion": "^2.1.4",
            "underscore": "^1.13.8",
            "tmp": "^0.2.6",
            "ws": "^8.21.0"
        }
    }
}
