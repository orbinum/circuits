{
  "name": "orbinum-circuits",
  "version": "0.5.1",
  "description": "Zero-Knowledge circuits for Orbinum privacy blockchain",
  "scripts": {
    "compile": "pnpm run compile:transfer",
    "compile:transfer": "bash scripts/build/compile.sh transfer",
    "compile:disclosure": "bash scripts/build/compile.sh disclosure",
    "compile:unshield": "bash scripts/build/compile.sh unshield",
    "compile:private-link": "bash scripts/build/compile.sh private_link",
    "setup": "pnpm run setup:transfer",
    "setup:transfer": "bash scripts/build/setup.sh transfer",
    "setup:disclosure": "bash scripts/build/setup.sh disclosure",
    "setup:unshield": "bash scripts/build/setup.sh unshield",
    "setup:private-link": "bash scripts/build/setup.sh private_link",
    "convert:disclosure": "bash scripts/build/convert-to-ark.sh disclosure",
    "convert:transfer": "bash scripts/build/convert-to-ark.sh transfer",
    "convert:unshield": "bash scripts/build/convert-to-ark.sh unshield",
    "convert:private-link": "bash scripts/build/convert-to-ark.sh private_link",
    "full-build:disclosure": "bash scripts/build/full-pipeline.sh disclosure",
    "full-build:transfer": "bash scripts/build/full-pipeline.sh transfer",
    "full-build:unshield": "bash scripts/build/full-pipeline.sh unshield",
    "full-build:private-link": "bash scripts/build/full-pipeline.sh private_link",
    "build-all": "bash scripts/build-all.sh",
    "manifest": "ts-node scripts/utils/generate-manifest.ts",
    "build-all:manifest": "pnpm run build-all && pnpm run manifest",
    "gen-input:disclosure": "ts-node scripts/generators/generate_disclosure_input.ts",
    "gen-input:transfer": "ts-node scripts/generators/generate_input.ts",
    "prove": "ts-node scripts/generators/generate_proof.ts",
    "prove:disclosure": "ts-node scripts/generators/generate_disclosure_proof.ts",
    "prove:transfer": "ts-node scripts/generators/generate_proof.ts",
    "e2e:disclosure": "ts-node scripts/e2e/e2e-disclosure.ts",
    "e2e:transfer": "ts-node scripts/e2e/e2e-transfer.ts",
    "test": "mocha --require ts-node/register 'test/**/*.test.ts' --timeout 100000",
    "test:js": "mocha test/**/*.test.js --timeout 100000",
    "build": "tsc",
    "bench": "ts-node benches/run-all.bench.ts",
    "bench:transfer": "ts-node benches/transfer.bench.ts",
    "bench:disclosure": "ts-node benches/disclosure.bench.ts",
    "clean": "rm -rf build/ ptau/ keys/ node_modules/ pnpm-lock.yaml",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "lint:circom": "bash scripts/utils/lint-circom.sh",
    "health": "bash scripts/utils/health-check.sh",
    "check-artifacts": "ts-node scripts/utils/check-artifacts.ts",
    "check-artifacts:build": "ts-node scripts/utils/check-artifacts.ts --build",
    "check-artifacts:cdn": "ts-node scripts/utils/check-artifacts.ts --cdn-only",
    "check-artifacts:npm": "ts-node scripts/utils/check-artifacts.ts --npm-only",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,json,md}": [
      "prettier --write"
    ],
    "circuits/*.circom": [
      "bash scripts/utils/lint-circom.sh"
    ]
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/circomlibjs": "^0.1.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.39",
    "@types/snarkjs": "^0.7.9",
    "chai": "^4.5.0",
    "circom_tester": "^0.0.19",
    "circomlib": "^2.0.5",
    "ffjavascript": "^0.2.63",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "mocha": "^10.8.2",
    "prettier": "^3.8.3",
    "snarkjs": "^0.7.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Orbinum Team",
  "license": "Apache-2.0",
  "dependencies": {
    "circomlibjs": "^0.1.7"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
