{
  "name": "orbinum-circuits",
  "version": "0.14.0",
  "description": "Zero-Knowledge circuits for Orbinum privacy blockchain",
  "scripts": {
    "compile": "pnpm run compile:transfer",
    "compile:transfer": "bash scripts/build/compile.sh transfer",
    "compile:unshield": "bash scripts/build/compile.sh unshield",
    "compile:value-proof": "bash scripts/build/compile.sh value_proof",
    "setup": "pnpm run setup:transfer",
    "setup:transfer": "bash scripts/build/setup.sh transfer",
    "setup:unshield": "bash scripts/build/setup.sh unshield",
    "setup:value-proof": "bash scripts/build/setup.sh value_proof",
    "convert:transfer": "bash scripts/build/pack-proving-key.sh transfer",
    "convert:unshield": "bash scripts/build/pack-proving-key.sh unshield",
    "convert:value-proof": "bash scripts/build/pack-proving-key.sh value_proof",
    "full-build:transfer": "bash scripts/build/full-pipeline.sh transfer",
    "full-build:unshield": "bash scripts/build/full-pipeline.sh unshield",
    "full-build:value-proof": "bash scripts/build/full-pipeline.sh value_proof",
    "build-all": "bash scripts/build-all.sh",
    "manifest": "ts-node scripts/utils/generate-manifest.ts",
    "release": "bash scripts/release/release.sh",
    "release:dry": "bash scripts/release/release.sh --dry-run",
    "release:verify": "ts-node scripts/release/verify-artifacts.ts",
    "release:restore": "ts-node scripts/release/restore-artifacts.ts",
    "test": "mocha --require ts-node/register 'test/**/*.test.ts' --timeout 100000",
    "test:js": "mocha test/**/*.test.js --timeout 100000",
    "build": "tsc",
    "clean": "rm -rf build/ ptau/ keys/ node_modules/ dist/ pnpm-lock.yaml",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "lint:circom": "bash scripts/utils/lint-circom.sh"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/circomlibjs": "^0.1.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "@types/snarkjs": "^0.7.9",
    "chai": "^6.2.2",
    "circom_tester": "^0.0.24",
    "circomlib": "^2.0.5",
    "ffjavascript": "^0.3.1",
    "mocha": "^11.7.5",
    "prettier": "^3.8.3",
    "snarkjs": "^0.7.6",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Orbinum Team",
  "license": "Apache-2.0",
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "circomlibjs": "^0.1.7"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
